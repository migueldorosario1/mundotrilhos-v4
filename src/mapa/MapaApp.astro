// Visualização restrita exclusivamente a linhas e sistemas EM OPERAÇÃO (preservando os não operacionais na base)
const sistemasOperacionais = sistemas.filter((s) => s.status === 'operacao');
const preservedNonOpCount = sistemas.length - sistemasOperacionais.length;
const operationalSysIds = new Set(sistemasOperacionais.map((s) => s.id));

const linhasOperacionaisGeojson = {
	type: 'FeatureCollection',
	features: (linhasGeojson.features || []).filter(
		(f: any) =>
			f.properties?.status === 'operacao' && operationalSysIds.has(f.properties?.sistema_id)
	),
};

const estacoesOperacionaisGeojson = {
	type: 'FeatureCollection',
	features: (estacoesGeojson.features || []).filter(
		(f: any) =>
			f.properties?.status === 'operacao' && operationalSysIds.has(f.properties?.sistema_id)
	),
};

const countryCounts: Record<string, number> = {};
const modalityCounts: Record<string, number> = {
	alta_velocidade: 0,
	metro: 0,
	vlt: 0,
	trem_convencional: 0,
	ferrovia_carga: 0,
};
for (const s of sistemasOperacionais) {
	const p = s.pais || 'Brasil';
	countryCounts[p] = (countryCounts[p] || 0) + 1;
	if (modalityCounts[s.tipo] !== undefined) {
		modalityCounts[s.tipo] += 1;
	}
}
const activeCountries = Object.keys(countryCounts);

function formatNum(val: number | null, suffix = ''): string {
	if (val === null || val === undefined) return t.drawer.nullValue;
	return val.toLocaleString(isEn ? 'en-US' : 'pt-BR') + suffix;
}

const payloadClient = JSON.stringify({
	lang,
	t,
	sistemas: sistemasOperacionais,
	linhasGeojson: linhasOperacionaisGeojson,
	estacoesGeojson: estacoesOperacionaisGeojson,
	fontes,
	relatedBySystemId,
	STATUS_COLORS,
	MODALITY_COLORS,
	COUNTRY_META,
});
---

<section class="mapa-shell" aria-label={t.pageTitle}>
	<div class="mapa-topbar">
		<div class="mapa-Heading-row">
			<div class="mapa-Heading">
				<span class="mapa-kicker">{t.heroKicker}</span>
				<h1>{t.heroTitle}</h1>
				<p class="mapa-subtitle">{t.heroSubtitle}</p>
			</div>
			<div class="lang-switch-group" role="navigation" aria-label="Idioma / Language">
				<a href="/mapa" class={`btn-lang ${!isEn ? 'is-active' : ''}`} hreflang="pt-br">
					🇧🇷 Português
				</a>
				<a href="/mapa/en" class={`btn-lang ${isEn ? 'is-active' : ''}`} hreflang="en">
					🇺🇸 English
				</a>
			</div>
		</div>

		<div class="mapa-controls" role="region" aria-label="Filtros do mapa">
			<div class="control-search">
				<input
					id="mapa-search-input"
					type="search"
					placeholder={t.searchPlaceholder}
					aria-label={t.searchPlaceholder}
				/>
			</div>

			<div class="control-selects">
				<label class="control-field">
					<span>{(t as any).filterPaisLabel || (isEn ? 'Country' : 'País')}</span>
					<select id="mapa-filter-pais">
						<option value="all">🌎 {isEn ? 'All' : 'Todos'} ({sistemasOperacionais.length})</option>
						{activeCountries.map((paisKey) => {
							const meta = COUNTRY_META[paisKey] || {
								flag: '🌐',
								labelPt: paisKey,
								labelEn: paisKey,
							};
							return (
								<option value={paisKey}>
									{meta.flag} {isEn ? meta.labelEn : meta.labelPt} ({countryCounts[paisKey]})
								</option>
							);
						})}
					</select>
				</label>

				<label class="control-field">
					<span>{t.filterTipoLabel}</span>
					<select id="mapa-filter-tipo">
						<option value="all">{t.filterAll} (5)</option>
						{MODALITY_ORDER.map((key) => (
							<option value={key}>
								{t.tipos[key]} ({modalityCounts[key] || 0})
							</option>
						))}
					</select>
				</label>

				<span class="operational-only-badge" title={isEn ? 'Non-operational systems remain preserved in the database' : 'Sistemas não operacionais permanecem preservados na base de dados'}>
					🟢 {isEn ? 'Operational lines only' : 'Somente linhas em operação'}
				</span>

				<div class="control-actions">
					<div class="proj-toggle-group" role="group" aria-label="Modo de visualização do mapa">
						<button type="button" id="mapa-btn-proj-globe" class="btn-proj is-active" data-proj="globe">
							{t.projectionGlobe}
						</button>
						<button type="button" id="mapa-btn-proj-flat" class="btn-proj" data-proj="mercator">
							{t.projectionFlat}
						</button>
					</div>
					<button type="button" id="mapa-btn-world" class="btn-secondary">
						{t.worldViewBtn}
					</button>
					<button type="button" id="mapa-btn-reset" class="btn-secondary">
						{t.resetViewBtn}
					</button>
					<button type="button" id="mapa-btn-share" class="btn-secondary">
						{t.shareViewBtn}
					</button>
				</div>
			</div>

			<div class="modality-pills-bar" role="group" aria-label={isEn ? 'Filter by 5 rail modalities' : 'Filtrar pelas 5 modalidades ferroviárias'}>
				<span class="country-pills-label">{isEn ? '5 Modalities (in operation):' : '5 Modalidades (em operação):'}</span>
				<button type="button" class="modality-pill-btn is-active" data-modality-jump="all">
					<span>✨ {isEn ? 'All 5 Modalities' : 'Todas as 5 modalidades'}</span>
					<strong>{sistemasOperacionais.length}</strong>
				</button>
				{MODALITY_ORDER.map((modKey) => (
					<button
						type="button"
						class="modality-pill-btn"
						data-modality-jump={modKey}
						style={`--mod-color:${MODALITY_COLORS[modKey]}`}
					>
						<i class="modality-dot" style={`background:${MODALITY_COLORS[modKey]}`}></i>
						<span>{t.tipos[modKey]}</span>
						<strong>{modalityCounts[modKey] || 0}</strong>
					</button>
				))}
			</div>

			<div class="country-pills-bar" role="group" aria-label={isEn ? 'Jump to country' : 'Ir rápido para país'}>
				<span class="country-pills-label">{isEn ? 'Countries mapped:' : 'Países no mapa:'}</span>
				<button type="button" class="country-pill-btn is-active" data-country-jump="all">
					🌎 {isEn ? 'World (All)' : 'Mundo (Todos)'} <strong>{sistemasOperacionais.length}</strong>
				</button>
				{activeCountries.map((paisKey) => {
					const meta = COUNTRY_META[paisKey] || {
						flag: '🌐',
						labelPt: paisKey,
						labelEn: paisKey,
					};
					return (
						<button type="button" class="country-pill-btn" data-country-jump={paisKey}>
							{meta.flag} {isEn ? meta.labelEn : meta.labelPt} <strong>{countryCounts[paisKey]}</strong>
						</button>
					);
				})}
			</div>
		</div>
	</div>

	<div class="mapa-workspace">
		<div class="mapa-canvas-wrap">
			<div id="maplibre-canvas" class="maplibre-canvas" role="application" aria-label={t.heroTitle}></div>

			<div class="mapa-legend" aria-label="Legenda do mapa por modalidade">
				<div class="legend-row">
					<span class="legend-kicker">
						🟢 {isEn ? 'In operation — 5 Modalities:' : 'Em operação — 5 Modalidades:'}
					</span>
					{MODALITY_ORDER.map((modKey) => (
						<button
							type="button"
							class="legend-item legend-modality-btn"
							data-modality-jump={modKey}
							title={isEn ? `Filter by ${t.tipos[modKey]}` : `Filtrar por ${t.tipos[modKey]}`}
						>
							<i
								class="legend-dot is-luminous"
								style={`background:${MODALITY_COLORS[modKey]}; --dot-glow:${MODALITY_COLORS[modKey]}`}
							></i>
							{t.tipos[modKey]}
						</button>
					))}
				</div>
				<div class="legend-zoom-hint" id="mapa-zoom-hint">
					{isEn
						? 'Showing operational lines only · Click any modality in the legend or filter bar to isolate it · Hover over stations for names.'
						: 'Exibindo somente linhas em operação · Clique numa modalidade na barra ou legenda para isolá-la · Passe o mouse nas estações para ver o nome.'}
				</div>
			</div>
		</div>

		<aside id="mapa-drawer" class="mapa-drawer" aria-live="polite" hidden>
			<div class="drawer-header">
				<div class="drawer-badges" id="drawer-badges"></div>
				<button type="button" id="drawer-close-btn" class="drawer-close" aria-label={t.drawer.close}>
					✕
				</button>
			</div>
			<div id="drawer-body" class="drawer-body"></div>
		</aside>
	</div>

	<!-- Lista alternativa acessível em texto e indexável para SEO -->
