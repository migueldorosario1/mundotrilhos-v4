<script type="application/json" id="mapa-trilhos-payload" set:html={payloadClient}></script>

<script>
	import * as maplibregl from 'maplibre-gl';
	import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?url';

	if (typeof (maplibregl as any).setWorkerUrl === 'function') {
		(maplibregl as any).setWorkerUrl(workerUrl);
	}

	function initMapaTrilhos() {
		const payloadEl = document.getElementById('mapa-trilhos-payload');
		const mapEl = document.getElementById('maplibre-canvas');
		if (!payloadEl || !mapEl) return;

		const data = JSON.parse(payloadEl.textContent || '{}');
		const {
			lang,
			t,
			sistemas,
			linhasGeojson,
			estacoesGeojson,
			fontes,
			relatedBySystemId,
			STATUS_COLORS,
			MODALITY_COLORS = {
				alta_velocidade: '#ff1744',
				metro: '#00b0ff',
				vlt: '#00e676',
				trem_convencional: '#ff9100',
				ferrovia_carga: '#aa00ff',
			},
			COUNTRY_META = {},
		} = data;
		const isEn = lang === 'en';
		const fontesById = Object.fromEntries((fontes || []).map((f: any) => [f.id, f]));
		const sistemasById = Object.fromEntries((sistemas || []).map((s: any) => [s.id, s]));
		const sistemasBySlug = Object.fromEntries((sistemas || []).map((s: any) => [s.slug, s]));

		const urlParams = new URLSearchParams(window.location.search);
		const initialSysSlug = urlParams.get('s') || urlParams.get('sistema');
		const initialPais = urlParams.get('pais') || 'all';
		const initialTipo = urlParams.get('tipo') || 'all';
		const initialLat = parseFloat(urlParams.get('lat') || '');
		const initialLon = parseFloat(urlParams.get('lon') || '');
		const initialZoom = parseFloat(urlParams.get('z') || '');

		const defaultCenter: [number, number] = [-47.5, -15.2];
		const defaultZoom = 3.8;

		let startCenter: [number, number] = defaultCenter;
		let startZoom = defaultZoom;

		if (initialSysSlug && sistemasBySlug[initialSysSlug]) {
			const s = sistemasBySlug[initialSysSlug];
			startCenter = [s.lon, s.lat];
			startZoom = s.zoom_inicial || 11.5;
		} else if (!Number.isNaN(initialLat) && !Number.isNaN(initialLon)) {
			startCenter = [initialLon, initialLat];
			if (!Number.isNaN(initialZoom)) startZoom = initialZoom;
		} else if (initialPais !== 'all' && COUNTRY_META[initialPais]) {
			startCenter = COUNTRY_META[initialPais].center;
			startZoom = COUNTRY_META[initialPais].zoom;
		}

		const searchInput = document.getElementById('mapa-search-input') as HTMLInputElement | null;
		const selectPais = document.getElementById('mapa-filter-pais') as HTMLSelectElement | null;
		const selectTipo = document.getElementById('mapa-filter-tipo') as HTMLSelectElement | null;
		const btnProjGlobe = document.getElementById('mapa-btn-proj-globe');
		const btnProjFlat = document.getElementById('mapa-btn-proj-flat');
		const btnWorld = document.getElementById('mapa-btn-world');
		const btnReset = document.getElementById('mapa-btn-reset');
		const btnShare = document.getElementById('mapa-btn-share');
		const drawer = document.getElementById('mapa-drawer');
		const drawerBody = document.getElementById('drawer-body');
		const drawerBadges = document.getElementById('drawer-badges');
		const drawerCloseBtn = document.getElementById('drawer-close-btn');

		if (selectPais && initialPais !== 'all') {
			selectPais.value = initialPais;
		}
		if (selectTipo && initialTipo !== 'all') {
			selectTipo.value = initialTipo;
		}

		let activeSlug: string | null = initialSysSlug;
		let currentProjection: 'globe' | 'mercator' =
			urlParams.get('proj') === 'mercator' ? 'mercator' : 'globe';
		let map: any = null;

		function escapeHtml(str: string): string {
			return String(str ?? '')
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;');
		}

		function formatVal(val: any, suffix = ''): string {
			if (val === null || val === undefined || val === '') {
				return `<span class="null-chip">${escapeHtml(t.drawer.nullValue)}</span>`;
			}
			if (typeof val === 'number') {
				return escapeHtml(val.toLocaleString(isEn ? 'en-US' : 'pt-BR') + suffix);
			}
			return escapeHtml(String(val) + suffix);
		}

		function syncUrlState(slug: string | null) {
			const url = new URL(window.location.href);
			if (slug) {
				url.searchParams.set('s', slug);
			} else {
				url.searchParams.delete('s');
			}
			if (map && typeof map.getCenter === 'function') {
				const c = map.getCenter();
				url.searchParams.set('lat', c.lat.toFixed(4));
				url.searchParams.set('lon', c.lng.toFixed(4));
				url.searchParams.set('z', map.getZoom().toFixed(1));
			}
			window.history.replaceState({}, '', url.toString());
		}

		let activeSysId: string | null =
			initialSysSlug && sistemasBySlug[initialSysSlug] ? sistemasBySlug[initialSysSlug].id : null;

		function applySystemHighlight(selectedSysId: string | null) {
			activeSysId = selectedSysId;

			// Destaca ou esmaece linhas na tabela de diretório
			document.querySelectorAll<HTMLElement>('[data-sys-row]').forEach((row) => {
				const rowId = row.getAttribute('data-sys-row') || '';
				if (!selectedSysId) {
					row.classList.remove('is-selected', 'is-dimmed');
				} else if (rowId === selectedSysId) {
					row.classList.add('is-selected');
					row.classList.remove('is-dimmed');
				} else {
					row.classList.add('is-dimmed');
					row.classList.remove('is-selected');
				}
			});

			if (!map || !map.isStyleLoaded()) return;

			try {
				if (!selectedSysId) {
					// Visão geral: ilumina intensamente tudo que está em operação
					if (map.getLayer('sistemas-operacao-glow')) {
						map.setPaintProperty('sistemas-operacao-glow', 'circle-opacity', 0.65);
					}
					if (map.getLayer('sistemas-circles')) {
						map.setPaintProperty('sistemas-circles', 'circle-opacity', [
							'case',
							['==', ['get', 'status'], 'operacao'],
							1.0,
							0.84,
						]);
						map.setPaintProperty('sistemas-circles', 'circle-stroke-opacity', 1.0);
						map.setPaintProperty('sistemas-circles', 'circle-stroke-width', [
							'case',
							['==', ['get', 'status'], 'operacao'],
							2.8,
							2.2,
						]);
					}
					if (map.getLayer('linhas-operacao-glow')) {
						map.setPaintProperty('linhas-operacao-glow', 'line-opacity', 0.65);
					}
					if (map.getLayer('linhas-operacao-casing')) {
						map.setPaintProperty('linhas-operacao-casing', 'line-opacity', 0.95);
					}
					if (map.getLayer('linhas-operacao')) {
						map.setPaintProperty('linhas-operacao', 'line-opacity', 1.0);
					}
					if (map.getLayer('linhas-obras-casing')) {
						map.setPaintProperty('linhas-obras-casing', 'line-opacity', 0.85);
					}
					if (map.getLayer('linhas-obras-projeto')) {
						map.setPaintProperty('linhas-obras-projeto', 'line-opacity', 0.92);
					}
					if (map.getLayer('estacoes-points')) {
						map.setPaintProperty('estacoes-points', 'circle-opacity', [
							'case',
							['==', ['get', 'status'], 'operacao'],
							1.0,
							0.85,
						]);
						map.setPaintProperty('estacoes-points', 'circle-stroke-opacity', 0.95);
					}
				} else {
					// Sistema clicado: fica claro e em destaque (1.0); os outros não clicados ficam clarinhos meio apagados (0.15)
					if (map.getLayer('sistemas-operacao-glow')) {
						map.setPaintProperty('sistemas-operacao-glow', 'circle-opacity', [
							'case',
							['==', ['get', 'id'], selectedSysId],
							0.85,
							0.06,
						]);
					}
					if (map.getLayer('sistemas-circles')) {
						map.setPaintProperty('sistemas-circles', 'circle-opacity', [
							'case',
							['==', ['get', 'id'], selectedSysId],
							1.0,
							0.16,
						]);
						map.setPaintProperty('sistemas-circles', 'circle-stroke-opacity', [
							'case',
							['==', ['get', 'id'], selectedSysId],
							1.0,
							0.22,
						]);
						map.setPaintProperty('sistemas-circles', 'circle-stroke-width', [
							'case',
							['==', ['get', 'id'], selectedSysId],
							3.6,
							1.5,
						]);
					}
					if (map.getLayer('linhas-operacao-glow')) {
						map.setPaintProperty('linhas-operacao-glow', 'line-opacity', [
							'case',
							['==', ['get', 'sistema_id'], selectedSysId],
							0.8,
							0.04,
						]);
					}
					if (map.getLayer('linhas-operacao-casing')) {
						map.setPaintProperty('linhas-operacao-casing', 'line-opacity', [
							'case',
							['==', ['get', 'sistema_id'], selectedSysId],
							1.0,
							0.12,
						]);
					}
					if (map.getLayer('linhas-operacao')) {
						map.setPaintProperty('linhas-operacao', 'line-opacity', [
							'case',
							['==', ['get', 'sistema_id'], selectedSysId],
							1.0,
							0.15,
						]);
					}
					if (map.getLayer('linhas-obras-casing')) {
						map.setPaintProperty('linhas-obras-casing', 'line-opacity', [
							'case',
							['==', ['get', 'sistema_id'], selectedSysId],
							0.95,
							0.1,
						]);
					}
					if (map.getLayer('linhas-obras-projeto')) {
						map.setPaintProperty('linhas-obras-projeto', 'line-opacity', [
							'case',
							['==', ['get', 'sistema_id'], selectedSysId],
							1.0,
							0.14,
						]);
					}
					if (map.getLayer('estacoes-points')) {
						map.setPaintProperty('estacoes-points', 'circle-opacity', [
							'case',
							['==', ['get', 'sistema_id'], selectedSysId],
							1.0,
							0.14,
						]);
						map.setPaintProperty('estacoes-points', 'circle-stroke-opacity', [
							'case',
							['==', ['get', 'sistema_id'], selectedSysId],
							1.0,
							0.16,
						]);
					}
				}
			} catch (err) {
				console.warn('[Mapa] Erro ao aplicar destaque de sistema:', err);
			}
		}

		function openSystemDrawer(sys: any) {
			if (!drawer || !drawerBody || !drawerBadges) return;
			activeSlug = sys.slug;
			syncUrlState(sys.slug);
			applySystemHighlight(sys.id);

			const nome = isEn ? sys.nome_en : sys.nome_pt;
			const resumo = isEn ? sys.resumo_en : sys.resumo_pt;
			const tipoLabel = t.tipos[sys.tipo] || sys.tipo;
			const statusLabel = t.status[sys.status] || sys.status;
			const stColor = STATUS_COLORS[sys.status] || '#00c853';
			const modColor = MODALITY_COLORS[sys.tipo] || '#00b0ff';

			const proxEntregas = sys.proximas_entregas
				? typeof sys.proximas_entregas === 'object'
					? isEn
						? sys.proximas_entregas.en
						: sys.proximas_entregas.pt
					: sys.proximas_entregas
				: null;

			const sysLines = (linhasGeojson.features || []).filter(
				(f: any) => f.properties?.sistema_id === sys.id
			);
			const sysStations = (estacoesGeojson.features || []).filter(
				(f: any) => f.properties?.sistema_id === sys.id
			);
			const hasApprox = sysLines.some((f: any) => f.properties?.geometria_aproximada);

			drawerBadges.innerHTML = `
				<span class="status-pill" style="--st-color:${modColor}">${escapeHtml(tipoLabel)}</span>
				<span class="status-pill" style="--st-color:${stColor}">${escapeHtml(statusLabel)}</span>
				<span class="verify-pill ${sys.verificado_completo ? 'is-verified' : 'is-partial'}">
					${escapeHtml(sys.verificado_completo ? t.drawer.verifiedBadge : t.drawer.partialBadge)}
				</span>
			`;

			const fotoHtml = sys.foto
				? `<figure class="drawer-figure">
						<img src="${escapeHtml(sys.foto.url)}" alt="${escapeHtml(nome)}" loading="lazy" />
						<figcaption>
							${escapeHtml(t.drawer.fields.imageCredit)}
							<a href="${escapeHtml(sys.foto.source_url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(sys.foto.credito)}</a>
							· ${escapeHtml(t.drawer.fields.imageLicense)} ${escapeHtml(sys.foto.licenca)}
						</figcaption>
				   </figure>`
				: '';

			const invHtml = sys.investimento
				? `${escapeHtml(sys.investimento.valor)}`
				: `<span class="null-chip">${escapeHtml(t.drawer.nullValue)}</span>`;

			const paxHtml =
				sys.passageiros_dia !== null && sys.passageiros_dia !== undefined
					? `${sys.passageiros_dia.toLocaleString(isEn ? 'en-US' : 'pt-BR')}${sys.ano_referencia ? ` (${sys.ano_referencia})` : ''}`
					: `<span class="null-chip">${escapeHtml(t.drawer.nullValue)}</span>`;

			const stationsHtml = sysStations.length
				? `<div class="drawer-section">
						<h3>🚉 ${escapeHtml(t.drawer.fields.estacoes)} (${sysStations.length})</h3>
						<div class="drawer-stations-chips">
							${sysStations
								.map((st: any) => {
									const stCoords = st.geometry?.coordinates || [];
									return `<button type="button" class="station-chip-btn" data-st-lon="${stCoords[0]}" data-st-lat="${stCoords[1]}" data-st-nome="${escapeHtml(st.properties?.nome || '')}" data-st-linha="${escapeHtml(st.properties?.linha || '')}">
										${escapeHtml(st.properties?.nome || '')}
									</button>`;
								})
								.join('')}
						</div>
				   </div>`
				: '';

			const fontesHtml = (sys.fontes || [])
				.map((fid: string) => fontesById[fid])
				.filter(Boolean)
				.map(
					(f: any) =>
						`<li>
							<a href="${escapeHtml(f.url)}" target="_blank" rel="noopener noreferrer">
								${escapeHtml(isEn ? f.nome_en : f.nome_pt)}
							</a>
							<span class="fonte-date">(${escapeHtml(f.data_consulta)})</span>
						</li>`
				)
				.join('');

			const relatedPosts = relatedBySystemId[sys.id] || [];
			const relatedHtml = relatedPosts.length
				? `<ul class="drawer-related-list">
						${relatedPosts
							.map(
								(p: any) => `
							<li>
								<a href="/blog/${escapeHtml(p.slug)}/">${escapeHtml(p.title)}</a>
								<span class="rel-date">${escapeHtml(p.pubDate)}</span>
							</li>`
							)
							.join('')}
				   </ul>`
				: `<p class="drawer-empty-note">${escapeHtml(t.drawer.fields.semMaterias)}</p>`;

			const sheetHref = isEn ? `/mapa/en/${sys.slug}` : `/mapa/${sys.slug}`;
			const twinHref = isEn ? `/mapa/${sys.slug}` : `/mapa/en/${sys.slug}`;

			drawerBody.innerHTML = `
				<h2 class="drawer-title">${escapeHtml(nome)}</h2>
				<p class="drawer-location">${escapeHtml(sys.cidade)} · ${escapeHtml(sys.uf)} (${escapeHtml(sys.pais)})</p>
				${hasApprox ? `<p class="approx-alert">⚠️ ${escapeHtml(t.drawer.approxGeomNote)}</p>` : ''}
				${fotoHtml}
				<p class="drawer-resumo">${escapeHtml(resumo)}</p>

				<div class="drawer-cta-row">
					<a href="${escapeHtml(sheetHref)}" class="btn-primary-sheet">
						${escapeHtml(t.drawer.openFullSheet)}
					</a>
				</div>

				<dl class="drawer-stats">
					<div>
						<dt>${escapeHtml(t.drawer.fields.operador)}</dt>
						<dd>${formatVal(sys.operador)}</dd>
					</div>
					<div>
						<dt>${escapeHtml(t.drawer.fields.inauguracao)}</dt>
						<dd>${formatVal(sys.inauguracao)}</dd>
					</div>
					<div>
						<dt>${escapeHtml(t.drawer.fields.extensao)}</dt>
						<dd>${formatVal(sys.extensao_km, ' km')}</dd>
					</div>
					<div>
						<dt>${escapeHtml(t.drawer.fields.linhas)}</dt>
						<dd>${formatVal(sys.n_linhas)}</dd>
					</div>
					<div>
						<dt>${escapeHtml(t.drawer.fields.estacoes)}</dt>
						<dd>${formatVal(sys.n_estacoes)}</dd>
					</div>
					<div>
						<dt>${escapeHtml(t.drawer.fields.passageirosDia)}</dt>
						<dd>${paxHtml}</dd>
					</div>
					<div class="full-span">
						<dt>${escapeHtml(t.drawer.fields.investimento)}</dt>
						<dd>${invHtml}</dd>
					</div>
					<div class="full-span">
						<dt>${escapeHtml(t.drawer.fields.proximasEntregas)}</dt>
						<dd>${formatVal(proxEntregas)}</dd>
					</div>
				</dl>

				${stationsHtml}

				<div class="drawer-section">
					<h3>${escapeHtml(t.drawer.fields.materiasRelacionadas)}</h3>
					${relatedHtml}
				</div>

				<div class="drawer-section">
					<h3>${escapeHtml(t.drawer.fields.fontes)}</h3>
					<ul class="drawer-sources-list">${fontesHtml}</ul>
				</div>

				<div class="drawer-twin-link">
					<a href="${escapeHtml(twinHref)}" hreflang="${escapeHtml(t.twinLang)}" rel="alternate">
						🌐 ${escapeHtml(t.twinLinkLabel)}
					</a>
				</div>
			`;

			drawerBody.querySelectorAll<HTMLButtonElement>('.station-chip-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					const lon = parseFloat(btn.getAttribute('data-st-lon') || '');
					const lat = parseFloat(btn.getAttribute('data-st-lat') || '');
					const stNome = btn.getAttribute('data-st-nome') || '';
					const stLinha = btn.getAttribute('data-st-linha') || '';
					if (!Number.isNaN(lon) && !Number.isNaN(lat) && map) {
						map.flyTo({ center: [lon, lat], zoom: 13.5, duration: 750 });
						if (hoverPopup) {
							hoverPopup
								.setLngLat([lon, lat])
								.setHTML(
									`<div class="hover-card">
										<div class="hover-title">🚉 ${escapeHtml(stNome)}</div>
										<div class="hover-sub">${escapeHtml(stLinha)}</div>
										<div class="hover-sys">${escapeHtml(nome)}</div>
									</div>`
								)
								.addTo(map);
						}
					}
				});
			});

			drawer.hidden = false;
			drawer.classList.add('is-open');
		}

		function closeDrawer() {
			if (!drawer) return;
			drawer.hidden = true;
			drawer.classList.remove('is-open');
			activeSlug = null;
			syncUrlState(null);
			applySystemHighlight(null);
		}

		drawerCloseBtn?.addEventListener('click', closeDrawer);

		// Abre imediatamente a gaveta se houver ?s=slug na URL (não depende de WebGL/rede)
		if (initialSysSlug && sistemasBySlug[initialSysSlug]) {
			openSystemDrawer(sistemasBySlug[initialSysSlug]);
		}

		// Mapeamento das modalidades presentes nas linhas de cada sistema (para operadores multimodais como Metrofor ou ViaMobilidade)
		const modalitiesBySystemId: Record<string, Set<string>> = {};
		for (const s of sistemas) {
			modalitiesBySystemId[s.id] = new Set([s.tipo]);
		}
		for (const f of linhasGeojson.features || []) {
			const sid = f.properties?.sistema_id;
			const ltipo = f.properties?.tipo;
			if (sid && ltipo) {
				if (!modalitiesBySystemId[sid]) modalitiesBySystemId[sid] = new Set();
				modalitiesBySystemId[sid].add(ltipo);
			}
		}

		function getFilteredSistemas(): any[] {
			const q = (searchInput?.value || '').trim().toLowerCase();
			const pais = selectPais?.value || 'all';
			const tipo = selectTipo?.value || 'all';

			return sistemas.filter((s: any) => {
				if (s.status !== 'operacao') return false;
				if (pais !== 'all' && s.pais !== pais) return false;
				if (tipo !== 'all') {
					const sysMods = modalitiesBySystemId[s.id];
					if (s.tipo !== tipo && (!sysMods || !sysMods.has(tipo))) return false;
				}
				if (q) {
					const hay = `${s.nome_pt} ${s.nome_en} ${s.pais} ${s.cidade} ${s.uf} ${s.operador} ${(s.tags || []).join(' ')}`.toLowerCase();
					if (!hay.includes(q)) return false;
				}
				return true;
			});
		}

		function syncCountryPills(selectedPais: string) {
			document.querySelectorAll<HTMLButtonElement>('[data-country-jump]').forEach((btn) => {
				const key = btn.getAttribute('data-country-jump') || 'all';
				btn.classList.toggle('is-active', key === selectedPais);
			});
		}

		function syncModalityPills(selectedTipo: string) {
			document.querySelectorAll<HTMLButtonElement>('[data-modality-jump]').forEach((btn) => {
				const key = btn.getAttribute('data-modality-jump') || 'all';
				btn.classList.toggle('is-active', key === selectedTipo);
			});
		}

		function flyToCountry(paisKey: string) {
			if (!map) return;
			closeDrawer();
			if (paisKey === 'all') {
				map.flyTo({ center: [20, 12], zoom: 1.75, duration: 950 });
				return;
			}
			const meta = COUNTRY_META[paisKey];
			if (meta && Array.isArray(meta.center)) {
				map.flyTo({ center: meta.center, zoom: meta.zoom || 4.5, duration: 950 });
				return;
			}
			const countrySystems = sistemas.filter((s: any) => s.pais === paisKey);
			if (countrySystems.length > 0) {
				const avgLon =
					countrySystems.reduce((acc: number, s: any) => acc + s.lon, 0) / countrySystems.length;
				const avgLat =
					countrySystems.reduce((acc: number, s: any) => acc + s.lat, 0) / countrySystems.length;
				map.flyTo({ center: [avgLon, avgLat], zoom: 4.5, duration: 950 });
			}
		}

		function buildSistemasGeojson(filteredList: any[]) {
			const selectedTipo = selectTipo?.value || 'all';
			return {
				type: 'FeatureCollection',
				features: filteredList.map((s: any) => {
					const effectiveTipo =
						selectedTipo !== 'all' && modalitiesBySystemId[s.id]?.has(selectedTipo)
							? selectedTipo
							: s.tipo;
					return {
						type: 'Feature',
						properties: {
							id: s.id,
							slug: s.slug,
							nome: isEn ? s.nome_en : s.nome_pt,
							cidade: s.cidade,
							uf: s.uf,
							status: s.status,
							status_label: t.status[s.status] || s.status,
							tipo: effectiveTipo,
							tipo_label: t.tipos[effectiveTipo] || effectiveTipo,
							color: MODALITY_COLORS[effectiveTipo] || '#00b0ff',
							zoom_inicial: s.zoom_inicial || 11.5,
						},
						geometry: {
							type: 'Point',
							coordinates: [s.lon, s.lat],
						},
					};
				}),
			};
		}

		function applyFilters() {
			const filtered = getFilteredSistemas();
			const allowedIds = new Set(filtered.map((s: any) => s.id));
			const selectedTipo = selectTipo?.value || 'all';

			// Atualiza tabela acessível
			document.querySelectorAll<HTMLElement>('[data-sys-row]').forEach((row) => {
				const id = row.getAttribute('data-sys-row') || '';
				row.style.display = allowedIds.has(id) ? '' : 'none';
			});

			// Atualiza sources no MapLibre (separando estritamente as 5 modalidades sem misturá-las)
			if (!map) return;
			const sysSrc = map.getSource('sistemas-points') as maplibregl.GeoJSONSource | undefined;
			if (sysSrc) {
				sysSrc.setData(buildSistemasGeojson(filtered) as any);
			}

			const linSrc = map.getSource('linhas-source') as maplibregl.GeoJSONSource | undefined;
			if (linSrc) {
				linSrc.setData({
					type: 'FeatureCollection',
					features: (linhasGeojson.features || []).filter((f: any) => {
						if (f.properties?.status !== 'operacao') return false;
						if (!allowedIds.has(f.properties?.sistema_id)) return false;
						if (selectedTipo !== 'all' && f.properties?.tipo !== selectedTipo) return false;
						return true;
					}),
				} as any);
			}

			const estSrc = map.getSource('estacoes-source') as maplibregl.GeoJSONSource | undefined;
			if (estSrc) {
				estSrc.setData({
					type: 'FeatureCollection',
					features: (estacoesGeojson.features || []).filter(
						(f: any) =>
							f.properties?.status === 'operacao' && allowedIds.has(f.properties?.sistema_id)
					),
				} as any);
			}
		}

		const modalityColorMatch: any = [
			'match',
			['get', 'tipo'],
			'alta_velocidade',
			MODALITY_COLORS.alta_velocidade,
			'metro',
			MODALITY_COLORS.metro,
			'vlt',
			MODALITY_COLORS.vlt,
			'trem_convencional',
			MODALITY_COLORS.trem_convencional,
			'ferrovia_carga',
			MODALITY_COLORS.ferrovia_carga,
			'#00b0ff',
		];

		const openStyle: maplibregl.StyleSpecification = {
			version: 8,
			projection: { type: currentProjection },
			sources: {
				'osm-tiles': {
					type: 'raster',
					tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'],
					tileSize: 256,
					maxzoom: 19,
					attribution:
						'© <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors (ODbL 1.0)',
				},
				'linhas-source': {
					type: 'geojson',
					data: linhasGeojson,
				},
				'estacoes-source': {
					type: 'geojson',
					data: estacoesGeojson,
				},
				'sistemas-points': {
					type: 'geojson',
					data: buildSistemasGeojson(sistemas) as any,
				},
			},
			layers: [
				{
					id: 'bg-base',
					type: 'background',
					paint: { 'background-color': '#cbd5e1' },
				},
				{
					id: 'osm-tiles-layer',
					type: 'raster',
					source: 'osm-tiles',
					minzoom: 0,
					maxzoom: 19,
					paint: {
						'raster-saturation': -0.92,
						'raster-contrast': -0.08,
						'raster-brightness-min': 0.12,
						'raster-brightness-max': 0.96,
					},
				},
				{
					id: 'linhas-operacao-glow',
					type: 'line',
					source: 'linhas-source',
					filter: ['==', ['get', 'status'], 'operacao'],
					layout: {
						'line-join': 'round',
						'line-cap': 'round',
					},
					paint: {
						'line-color': modalityColorMatch,
						'line-width': ['interpolate', ['linear'], ['zoom'], 3, 8, 9, 13, 13, 18],
						'line-blur': 4.5,
						'line-opacity': 0.65,
					},
				},
				{
					id: 'linhas-operacao-casing',
					type: 'line',
					source: 'linhas-source',
					filter: ['==', ['get', 'status'], 'operacao'],
					layout: {
						'line-join': 'round',
						'line-cap': 'round',
					},
					paint: {
						'line-color': '#0f172a',
						'line-width': ['interpolate', ['linear'], ['zoom'], 3, 4.6, 9, 7.2, 13, 10.2],
						'line-opacity': 0.95,
					},
				},
				{
					id: 'linhas-operacao',
					type: 'line',
					source: 'linhas-source',
					filter: ['==', ['get', 'status'], 'operacao'],
					layout: {
						'line-join': 'round',
						'line-cap': 'round',
					},
					paint: {
						'line-color': modalityColorMatch,
						'line-width': ['interpolate', ['linear'], ['zoom'], 3, 3.0, 9, 4.8, 13, 7.0],
						'line-opacity': 1.0,
					},
				},
				{
					id: 'estacoes-hit-area',
					type: 'circle',
					source: 'estacoes-source',
					minzoom: 5.5,
					paint: {
						'circle-radius': ['interpolate', ['linear'], ['zoom'], 5.5, 10, 10, 14, 14, 18],
						'circle-color': '#10b981',
						'circle-opacity': 0.01,
					},
				},
				{
					id: 'estacoes-points',
					type: 'circle',
					source: 'estacoes-source',
					minzoom: 5.5,
					paint: {
						'circle-radius': ['interpolate', ['linear'], ['zoom'], 5.5, 3.6, 9, 5.2, 13, 7.2],
						'circle-color': '#ffffff',
						'circle-stroke-width': ['interpolate', ['linear'], ['zoom'], 5.5, 2.0, 12, 2.8],
						'circle-stroke-color': '#0f172a',
						'circle-opacity': 0.98,
						'circle-stroke-opacity': 0.98,
					},
				},
				{
					id: 'sistemas-operacao-glow',
					type: 'circle',
					source: 'sistemas-points',
					filter: ['==', ['get', 'status'], 'operacao'],
					paint: {
						'circle-radius': ['interpolate', ['linear'], ['zoom'], 2, 13, 6, 16, 12, 12],
						'circle-color': ['get', 'color'],
						'circle-blur': 0.65,
						'circle-opacity': 0.65,
					},
				},
				{
					id: 'sistemas-circles',
					type: 'circle',
					source: 'sistemas-points',
					paint: {
						'circle-radius': [
							'interpolate',
							['linear'],
							['zoom'],
							2,
							7.8,
							7,
							9.8,
							12,
							7.0,
						],
						'circle-color': ['get', 'color'],
						'circle-stroke-width': 2.8,
						'circle-stroke-color': '#ffffff',
						'circle-opacity': 1.0,
					},
				},
			],
		};

		let hoverPopup: any = null;

		try {
			map = new maplibregl.Map({
				container: mapEl,
				style: openStyle,
				center: startCenter,
				zoom: startZoom,
				minZoom: 1.2,
				maxZoom: 18,
				canvasContextAttributes: { preserveDrawingBuffer: true },
			});

			map.addControl(new maplibregl.NavigationControl({ showCompass: true }), 'top-right');
			map.addControl(new maplibregl.ScaleControl({ maxWidth: 120, unit: 'metric' }), 'bottom-left');

			hoverPopup = new maplibregl.Popup({
				closeButton: false,
				closeOnClick: false,
				offset: 12,
				maxWidth: '280px',
				className: 'mapa-hover-tooltip',
			});
		} catch (err) {
			console.warn('[Mapa] WebGL indisponível neste dispositivo:', err);
		}

		if (map) {
			const showStationTooltip = (feat: any) => {
				if (!feat || !hoverPopup) return;
				const props = feat.properties || {};
				const coords = (feat.geometry as any).coordinates.slice();
				const sysObj = sistemasById[props.sistema_id];
				const sysNome = isEn
					? props.sistema_nome_en || sysObj?.nome_en || ''
					: props.sistema_nome_pt || sysObj?.nome_pt || '';
				const modKey = sysObj?.tipo || 'metro';
				const modLabel = t.tipos[modKey] || modKey;
				const modColor = MODALITY_COLORS[modKey] || '#00b0ff';

				hoverPopup
					.setLngLat(coords)
					.setHTML(
						`<div class="hover-card">
							<div class="hover-title">🚉 ${escapeHtml(props.nome)}</div>
							${props.linha ? `<div class="hover-sub">${escapeHtml(props.linha)}</div>` : ''}
							<div class="hover-meta">
								<span class="hover-dot" style="background:${modColor}"></span>
								<span>${escapeHtml(sysNome)} · ${escapeHtml(modLabel)}</span>
							</div>
						</div>`
					)
					.addTo(map);
			};

			map.on('load', () => {
				if (initialPais !== 'all' || initialTipo !== 'all') {
					syncCountryPills(initialPais);
					syncModalityPills(initialTipo);
					applyFilters();
				}
				if (activeSysId) {
					applySystemHighlight(activeSysId);
					const firstSt = (estacoesGeojson.features || []).find(
						(f: any) => f.properties?.sistema_id === activeSysId
					);
					if (firstSt) {
						showStationTooltip(firstSt);
					}
				}
			});

			const clickableLayers = [
				'sistemas-circles',
				'linhas-operacao',
				'estacoes-hit-area',
				'estacoes-points',
			];

			for (const layerId of clickableLayers) {
				map.on('mouseenter', layerId, () => {
					map.getCanvas().style.cursor = 'pointer';
				});
				map.on('mouseleave', layerId, () => {
					map.getCanvas().style.cursor = '';
				});
			}

			// Hover instantâneo nas estações (ponto ou área de aproximação): abre o nome da estação ao passar o mouse
			const handleStationHover = (e: any) => {
				const feat = e.features?.[0];
				if (feat) showStationTooltip(feat);
			};

			map.on('mousemove', 'estacoes-hit-area', handleStationHover);
			map.on('mousemove', 'estacoes-points', handleStationHover);

			map.on('mouseleave', 'estacoes-hit-area', () => {
				hoverPopup?.remove();
			});
			map.on('mouseleave', 'estacoes-points', () => {
				hoverPopup?.remove();
			});

			// Hover nos marcadores de sistema (quando não estiver sobre estação)
			map.on('mousemove', 'sistemas-circles', (e: any) => {
				const stFeats = map.queryRenderedFeatures(e.point, { layers: ['estacoes-points'] });
				if (stFeats && stFeats.length > 0) return;
				const feat = e.features?.[0];
				if (!feat || !hoverPopup) return;
				const props = feat.properties || {};
				const coords = (feat.geometry as any).coordinates.slice();
				const modColor = props.color || MODALITY_COLORS[props.tipo] || '#00b0ff';
				const modLabel = props.tipo_label || t.tipos[props.tipo] || props.tipo;

				hoverPopup
					.setLngLat(coords)
					.setHTML(
						`<div class="hover-card">
							<div class="hover-title">${escapeHtml(props.nome)}</div>
							<div class="hover-sub">${escapeHtml(props.cidade)} (${escapeHtml(props.uf)})</div>
							<div class="hover-meta">
								<span class="hover-dot" style="background:${modColor}"></span>
								<span>${escapeHtml(modLabel)} · ${escapeHtml(props.status_label || props.status)}</span>
							</div>
						</div>`
					)
					.addTo(map);
			});

			map.on('mouseleave', 'sistemas-circles', () => {
				hoverPopup?.remove();
			});

			// Hover nas linhas (quando não estiver sobre estação ou marcador de sistema)
			const handleLineHover = (e: any) => {
				const topFeats = map.queryRenderedFeatures(e.point, {
					layers: ['estacoes-points', 'sistemas-circles'],
				});
				if (topFeats && topFeats.length > 0) return;
				const feat = e.features?.[0];
				if (!feat || !hoverPopup) return;
				const props = feat.properties || {};
				const sysObj = sistemasById[props.sistema_id];
				const sysNome = isEn
					? props.sistema_nome_en || sysObj?.nome_en || ''
					: props.sistema_nome_pt || sysObj?.nome_pt || '';
				const modKey = props.tipo || sysObj?.tipo || 'metro';
				const modLabel = t.tipos[modKey] || modKey;
				const modColor = MODALITY_COLORS[modKey] || '#00b0ff';

				hoverPopup
					.setLngLat(e.lngLat)
					.setHTML(
						`<div class="hover-card">
							<div class="hover-title">🚆 ${escapeHtml(props.linha || sysNome)}</div>
							<div class="hover-meta">
								<span class="hover-dot" style="background:${modColor}"></span>
								<span>${escapeHtml(sysNome)} · ${escapeHtml(modLabel)}</span>
							</div>
						</div>`
					)
					.addTo(map);
			};

			map.on('mousemove', 'linhas-operacao', handleLineHover);
			map.on('mouseleave', 'linhas-operacao', () => hoverPopup?.remove());

			// Clique em qualquer sistema, linha ou estação: destaca o sistema clicado e apaga os demais
			map.on('click', 'sistemas-circles', (e: any) => {
				const feat = e.features?.[0];
				if (!feat) return;
				const sysId = feat.properties?.id;
				const sys = sistemasById[sysId];
				if (sys) {
					map.flyTo({
						center: [sys.lon, sys.lat],
						zoom: Math.max(map.getZoom(), sys.zoom_inicial || 11.5),
						duration: 900,
					});
					openSystemDrawer(sys);
				}
			});

			map.on('click', 'linhas-operacao', (e: any) => {
				const feat = e.features?.[0];
				const sys = sistemasById[feat?.properties?.sistema_id];
				if (sys) openSystemDrawer(sys);
			});

			map.on('click', 'estacoes-points', (e: any) => {
				const feat = e.features?.[0];
				if (!feat) return;
				const props = feat.properties || {};
				const sys = sistemasById[props.sistema_id];
				if (sys) openSystemDrawer(sys);
			});

			// Clicar no fundo vazio do mapa limpa a seleção e restaura a luminosidade geral
			map.on('click', (e: any) => {
				const hits = map.queryRenderedFeatures(e.point, { layers: clickableLayers });
				if (!hits || hits.length === 0) {
					if (activeSysId) {
						closeDrawer();
					}
				}
			});
		}

		if (map) {
			map.on('moveend', () => {
				syncUrlState(activeSlug);
			});
		}

		searchInput?.addEventListener('input', applyFilters);
		selectPais?.addEventListener('change', () => {
			const chosen = selectPais.value || 'all';
			syncCountryPills(chosen);
			applyFilters();
			flyToCountry(chosen);
		});
		selectTipo?.addEventListener('change', () => {
			const chosenTipo = selectTipo.value || 'all';
			syncModalityPills(chosenTipo);
			applyFilters();
		});

		document.querySelectorAll<HTMLButtonElement>('[data-country-jump]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const key = btn.getAttribute('data-country-jump') || 'all';
				if (selectPais) {
					selectPais.value = key;
				}
				syncCountryPills(key);
				applyFilters();
				flyToCountry(key);
			});
		});

		document.querySelectorAll<HTMLButtonElement>('[data-modality-jump]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const key = btn.getAttribute('data-modality-jump') || 'all';
				const currentVal = selectTipo?.value || 'all';
				const nextVal = key !== 'all' && currentVal === key ? 'all' : key;
				if (selectTipo) {
					selectTipo.value = nextVal;
				}
				syncModalityPills(nextVal);
				applyFilters();
			});
		});

		function setMapProjection(proj: 'globe' | 'mercator') {
			currentProjection = proj;
			btnProjGlobe?.classList.toggle('is-active', proj === 'globe');
			btnProjFlat?.classList.toggle('is-active', proj === 'mercator');
			if (map && typeof map.setProjection === 'function') {
				try {
					map.setProjection({ type: proj });
				} catch (err) {
					console.warn('[Mapa] Erro ao alternar projeção:', err);
				}
			}
			const url = new URL(window.location.href);
			url.searchParams.set('proj', proj);
			window.history.replaceState({}, '', url.toString());
		}

		if (currentProjection === 'mercator') {
			btnProjGlobe?.classList.remove('is-active');
			btnProjFlat?.classList.add('is-active');
		}

		btnProjGlobe?.addEventListener('click', () => setMapProjection('globe'));
		btnProjFlat?.addEventListener('click', () => setMapProjection('mercator'));

		btnWorld?.addEventListener('click', () => {
			if (selectPais) selectPais.value = 'all';
			syncCountryPills('all');
			applyFilters();
			flyToCountry('all');
		});

		btnReset?.addEventListener('click', () => {
			if (selectPais) selectPais.value = 'Brasil';
			syncCountryPills('Brasil');
			applyFilters();
			flyToCountry('Brasil');
		});

		btnShare?.addEventListener('click', async () => {
			syncUrlState(activeSlug);
			try {
				await navigator.clipboard.writeText(window.location.href);
				if (btnShare) {
					const orig = btnShare.textContent;
					btnShare.textContent = t.shareCopied;
					setTimeout(() => {
						btnShare.textContent = orig;
					}, 1800);
				}
			} catch {
				// fallback silencioso
			}
		});

		document.querySelectorAll<HTMLButtonElement>('[data-focus-system]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const slug = btn.getAttribute('data-focus-system') || '';
				const sys = sistemasBySlug[slug];
				if (!sys) return;
				mapEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
				map.flyTo({
					center: [sys.lon, sys.lat],
					zoom: sys.zoom_inicial || 11.5,
					duration: 900,
				});
				openSystemDrawer(sys);
			});
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initMapaTrilhos);
	} else {
		initMapaTrilhos();
	}
</script>

