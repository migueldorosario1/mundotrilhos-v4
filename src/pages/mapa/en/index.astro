---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';

import estacoesRaw from '../../../data/mapa/estacoes.geojson?raw';
import fontesData from '../../../data/mapa/fontes.json';
import linhasRaw from '../../../data/mapa/linhas.geojson?raw';
import sistemasData from '../../../data/mapa/sistemas.json';

import MapaApp from '../../../mapa/MapaApp.astro';
import { getMapaI18n, type MapaLang } from '../../../mapa/i18n';
import { findRelatedPostsForSystem } from '../../../mapa/relatedPosts';
import type { FonteCitada, RelatedBlogPost, SistemaRegistro } from '../../../mapa/types';

const lang: MapaLang = 'en';
const t = getMapaI18n(lang);

const sistemas = sistemasData as SistemaRegistro[];
const fontes = fontesData as FonteCitada[];
const linhasGeojson = JSON.parse(linhasRaw);
const estacoesGeojson = JSON.parse(estacoesRaw);

const allPosts = await getCollection('blog');
const relatedBySystemId: Record<string, RelatedBlogPost[]> = {};

for (const sys of sistemas) {
	relatedBySystemId[sys.id] = findRelatedPostsForSystem(sys, allPosts, 4);
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${t.pageTitle} | Mundo Trilhos`} description={t.pageDescription} />
		<link rel="alternate" hreflang="pt-br" href="https://www.mundotrilhos.com/mapa" />
		<style>
			html,
			body {
				overflow-x: hidden;
				max-width: 100vw;
			}
			main.mapa-page-main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="mapa-page-main">
			<MapaApp
				lang={lang}
				sistemas={sistemas}
				linhasGeojson={linhasGeojson}
				estacoesGeojson={estacoesGeojson}
				fontes={fontes}
				relatedBySystemId={relatedBySystemId}
			/>
		</main>
		<Footer />
	</body>
</html>
