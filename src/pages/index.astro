---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import destaquesAll from '../data/destaques.json';
import destaquesCfg from '../data/destaques_config.json';

import estacoesRaw from '../data/mapa/estacoes.geojson?raw';
import fontesData from '../data/mapa/fontes.json';
import linhasRaw from '../data/mapa/linhas.geojson?raw';
import sistemasData from '../data/mapa/sistemas.json';
import MapaApp from '../mapa/MapaApp.astro';
import { findRelatedPostsForSystem } from '../mapa/relatedPosts';
import type { FonteCitada, RelatedBlogPost, SistemaRegistro } from '../mapa/types';

// Regras de Destaques (ordem Miguel, 2026-08-06):
// 1) a seção só renderiza se estiver LIGADA no painel (destaques_config.json);
//    desligada, a home mostra só os mais recentes na frente;
// 2) destaque com mais de max_age_hours sai do topo (defesa em profundidade —
//    o gerador ga4_destaques.py já filtra; aqui segura mesmo com JSON velho);
// 3) destaque exibido no topo NÃO repete na lista de recentes embaixo.
const _todosPosts = (await getCollection('blog'));
const _horasMax = Number(destaquesCfg.max_age_hours ?? 48);
const _maxAgeMs = _horasMax > 0 ? _horasMax * 3600_000 : Infinity;
const _porUrl = new Map(_todosPosts.map((p) => [`/blog/${p.id}/`, p]));
const destaques = (destaquesCfg.enabled === true ? destaquesAll : []).filter((d) => {
	const p = _porUrl.get(d.url);
	return p && Date.now() - new Date(p.data.pubDate).getTime() <= _maxAgeMs;
});
const _urlsDestaque = new Set(destaques.map((d) => d.url));

const posts = _todosPosts.filter((post) => !_urlsDestaque.has(`/blog/${post.id}/`)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const sistemas = sistemasData as SistemaRegistro[];
const fontes = fontesData as FonteCitada[];
const linhasGeojson = JSON.parse(linhasRaw);
const estacoesGeojson = JSON.parse(estacoesRaw);
const relatedBySystemId: Record<string, RelatedBlogPost[]> = {};

for (const sys of sistemas) {
	relatedBySystemId[sys.id] = findRelatedPostsForSystem(sys, _todosPosts, 4);
}
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			html,
			body {
				overflow-x: hidden;
				max-width: 100vw;
			}
			main {
				width: min(1280px, calc(100% - 2em));
				box-sizing: border-box;
			}

			.manifesto-banner {
				display: block;
				position: relative;
				isolation: isolate;
				overflow: hidden;
				margin: 0 0 2rem;
				padding: clamp(1.5rem, 4vw, 3rem);
				border-radius: 16px;
				background: #132e32;
				color: #fff;
				text-decoration: none;
				border: 1px solid #315156;
			}
			.manifesto-banner::after {
				content: '';
				position: absolute;
				inset: 0;
				z-index: -1;
				background: repeating-linear-gradient(120deg, transparent 0 66px, #ffffff05 66px 68px);
			}
			.manifesto-banner:hover { color: #fff; border-color: #f4b36a; }
			.manifesto-banner:focus-visible { outline: 3px solid #d35400; outline-offset: 5px; }
			.manifesto-kicker { display: block; color: #f4b36a; font-size: .75rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
			.manifesto-heading { color: #fff; font-size: clamp(2.6rem, 6.5vw, 5.5rem); line-height: 1.08; letter-spacing: -.035em; margin: .5rem 0 .7rem; }
			.manifesto-subtitle { max-width: 44rem; margin: 0; font-size: clamp(1.1rem, 2.4vw, 1.6rem); line-height: 1.4; color: #e3eeee; }
			.manifesto-cta { display: inline-block; margin-top: 1.5rem; padding: .5rem 1rem; background: #f4b36a; color: #132e32; border-radius: 6px; font-size: .9rem; font-weight: 700; }

			.home-mapa-section {
				margin-bottom: 1.5rem;
			}
			.home-mapa-section :global(.mapa-shell) {
				padding: 0.5rem 0 1.25rem;
			}
			ul.news-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul.news-grid li {
				min-width: 0;
			}
			ul.news-grid li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			/* grade uniforme */
			ul.news-grid li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul.news-grid li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul.news-grid li a:hover h4,
			ul.news-grid li a:hover .date {
				color: rgb(var(--accent));
			}
			ul.news-grid a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul.news-grid {
					gap: 0.5em;
				}
				ul.news-grid li {
					width: 100%;
					text-align: center;
				}
			}


			/* === Destaques (v2 polida) === */
			.featured-voices { margin-bottom: 3rem; }
			.fv-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
				gap: 1.5rem;
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.fv-grid li:first-child { grid-column: 1 / -1; }
			.fv-card {
				display: flex;
				flex-direction: column;
				height: 100%;
				border: 1px solid rgba(var(--gray), 0.25);
				border-radius: 14px;
				overflow: hidden;
				background: #ffffff;
				transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
			}
			.fv-link:hover .fv-card {
				transform: translateY(-4px);
				box-shadow: 0 12px 32px rgba(0,0,0,0.18);
				border-color: rgb(var(--accent));
			}
			.fv-grid li:first-child .fv-card { flex-direction: row; min-height: 280px; }
			.fv-img { width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block; }
			.fv-grid li:first-child .fv-img { width: 52%; aspect-ratio: auto; }
			.fv-content {
				padding: 1.1rem 1.25rem 1.3rem;
				display: flex;
				flex-direction: column;
				gap: 0.55rem;
				justify-content: center;
			}
			.fv-grid li:first-child .fv-content { padding: 2.25rem; }
			.fv-kicker {
				display: inline-block;
				font-size: 0.68rem;
				font-weight: 800;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: rgb(var(--accent));
				border: 1px solid rgb(var(--accent));
				border-radius: 999px;
				padding: 0.18rem 0.7rem;
				width: fit-content;
			}
			.fv-title {
				font-size: 1.08rem;
				font-weight: 700;
				line-height: 1.28;
				margin: 0;
				color: rgb(var(--black));
			}
			.fv-grid li:first-child .fv-title { font-size: 1.7rem; letter-spacing: -0.01em; }
			.fv-desc {
				font-size: 0.87rem;
				color: rgb(var(--gray));
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.fv-link { text-decoration: none; display: block; height: 100%; }
			.fv-link:hover .fv-title { color: rgb(var(--accent)); }
			@media (max-width: 900px) {
				.fv-grid { grid-template-columns: repeat(2, 1fr); }
				.fv-grid li:first-child { grid-column: span 2; }
			}
			@media (max-width: 560px) {
				.fv-grid { grid-template-columns: 1fr; }
				.fv-grid li:first-child { grid-column: span 1; }
				.fv-grid li:first-child .fv-card { flex-direction: column; }
				.fv-grid li:first-child .fv-img { width: 100%; }
			}

			/* tipografia fluida e quebra elegante (v3 layout desktop) */
			.fv-title, .title {
				overflow-wrap: break-word;
				hyphens: auto;
			}
			.fv-title { font-size: clamp(0.95rem, 0.85rem + 0.4vw, 1.1rem); }
			.fv-grid li:first-child .fv-title { font-size: clamp(1.3rem, 1.1rem + 1vw, 1.8rem); }
			.title { font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem) !important; line-height: 1.25 !important; }
			ul.news-grid li img { width: 100%; height: auto; }
		
		/* label mini dos destaques (Miguel 2026-08-05): pequenininho, na cor do
		   site, como chapeuzinho sobre a foto — sem títulão */
		.fv-mini {
			font-size: 0.78rem !important;
			font-weight: 800;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			color: var(--accent) !important;
			display: flex;
			align-items: center;
			gap: 0.5rem;
			margin: 0 0 1rem;
		}
		.fv-mini::before {
			content: '';
			display: inline-block;
			width: 6px;
			height: 14px;
			background: var(--accent);
			border-radius: 2px;
		}
</style>
	</head>
	<body>
		<Header />
		<main>
			<a class="manifesto-banner" href="https://www.ocafezinho.com/2026-11-12/e-trem-lula/" aria-label="Leia o manifesto É trem, Lula! no Cafezinho">
				<span class="manifesto-kicker">Manifesto · Miguel do Rosário</span>
				<h1 class="manifesto-heading">É trem, Lula!</h1>
				<p class="manifesto-subtitle">Por um projeto nacional de mobilidade sobre trilhos</p>
				<span class="manifesto-cta">Leia o manifesto no Cafezinho <span aria-hidden="true">→</span></span>
			</a>

			<div class="home-mapa-section">
				<MapaApp
					lang="pt-br"
					isHome={true}
					sistemas={sistemas}
					linhasGeojson={linhasGeojson}
					estacoesGeojson={estacoesGeojson}
					fontes={fontes}
					relatedBySystemId={relatedBySystemId}
				/>
			</div>
			{destaques.length > 0 && (
			<section class="featured-voices">
				<h2 class="fv-section-title fv-mini">Destaques</h2>
				<ul class="fv-grid">
					{
						destaques.map((d) => (
							<li>
								<a href={d.url} class="fv-card">
									{d.hero && <img class="fv-img" src={d.hero} alt={d.title} loading="lazy" />}
									<div class="fv-content">
										{d.kicker && <span class="fv-kicker">{d.kicker}</span>}
										<h3 class="fv-title">{d.title}</h3>
										<p class="fv-desc">{d.description}</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
			)}
			<section>
				<ul class="news-grid">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<img width="720" height="360" src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
