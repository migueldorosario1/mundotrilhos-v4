---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	// Premium Tag Mapping for Mundo Trilhos
	const tagMap = {
		// Modais de Transporte
		'vlt': {
			title: 'Mobilidade Urbana',
			subtitle: 'Veículos Leves sobre Trilhos (VLT)',
			description: 'Acompanhe as principais novidades, inovações tecnológicas e projetos de VLTs que transformam a mobilidade urbana nas cidades brasileiras e globais.',
			image: '/images/tags/vlt.png',
			color: 'linear-gradient(135deg, #1e3c72, #2a5298)',
			bgPosition: 'center 45%'
		},
		'alta-velocidade': {
			title: 'Alta Velocidade',
			subtitle: 'Trens de Alta Velocidade (TAV)',
			description: 'A fronteira da velocidade sobre trilhos. Projetos, parcerias internacionais e o desenvolvimento das redes de alta velocidade pelo mundo.',
			image: '/images/tags/alta-velocidade.png',
			color: 'linear-gradient(135deg, #cb2d3e, #ef473a)',
			bgPosition: 'center 35%'
		},
		'metro': {
			title: 'Sistemas Metropolitanos',
			subtitle: 'Metrôs & Subterrâneos',
			description: 'A espinha dorsal do transporte de alta capacidade. Expansões, novas linhas, inovações em trens autônomos (UTO) e tecnologia CBTC.',
			image: '/images/tags/metro.png',
			color: 'linear-gradient(135deg, #0052D4, #4364F7)',
			bgPosition: 'center 35%'
		},
		'monotrilho': {
			title: 'Transporte Elevado',
			subtitle: 'Sistemas de Monotrilho',
			description: 'Tecnologia elevada de alta eficiência espacial. Automação, vigas-guia e as novidades das principais linhas metropolitanas.',
			image: '/images/tags/monotrilho.png',
			color: 'linear-gradient(135deg, #f7971e, #ffd200)',
			bgPosition: 'center 35%'
		},
		'carga': {
			title: 'Logística & Transporte',
			subtitle: 'Ferrovias de Carga',
			description: 'O escoamento de grãos, minérios e bens manufaturados. A infraestrutura estratégica que move a economia continental.',
			image: '/images/tags/carga.png',
			color: 'linear-gradient(135deg, #56ab2f, #a8e063)',
			bgPosition: 'center 35%'
		},
		'regional': {
			title: 'Conexão Metropolitana',
			subtitle: 'Trens Regionais',
			description: 'O transporte que encurta distâncias entre cidades vizinhas, integrando regiões e promovendo o desenvolvimento sustentável.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #00b4db, #0083b0)'
		},
		'turismo': {
			title: 'Patrimônio & História',
			subtitle: 'Trens Turísticos',
			description: 'A nostalgia do vapor e da história ferroviária preservada. Rotas históricas, passeios de Maria Fumaça e preservação da memória ferroviária.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #7b4397, #dc2430)'
		},
		// Regiões / Geográficos — Nordeste
		'bahia': {
			title: 'Bahia',
			subtitle: 'Ferrovias da Bahia',
			description: 'FIOL, FNS e a retomada ferroviária baiana. Acompanhamento de obras, concessões e investimentos no estado.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #1a472a, #2e8b57)'
		},
		'ceara': {
			title: 'Ceará',
			subtitle: 'Ferrovias do Ceará',
			description: 'Projetos ferroviários no Ceará: VLTs, trens de carga e integração regional do Nordeste.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #1e3a5f, #3a7bd5)'
		},
		'pernambuco': {
			title: 'Pernambuco',
			subtitle: 'Ferrovias de Pernambuco',
			description: 'Mobilidade e logística ferroviária em Pernambuco: metrô do Recife, carga e expansões previstas.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #4a148c, #7b1fa2)'
		},
		'nordeste': {
			title: 'Região Nordeste',
			subtitle: 'Ferrovias do Nordeste',
			description: 'A transnordestina e as ferrovias que integram os estados do Nordeste brasileiro.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #e65100, #ff9800)'
		},
		// Norte
		'para': {
			title: 'Pará',
			subtitle: 'Ferrovias do Pará',
			description: 'EF-170 (Ferrogrão) e a logística ferroviária paraense que conecta o interior aos portos do Atlântico.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #0d3b1e, #2d6a4f)'
		},
		'amazonas': {
			title: 'Amazonas',
			subtitle: 'Ferrovias da Amazônia',
			description: 'Projetos de integração ferroviária na Amazônia e conectividade para a região norte.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #004d40, #00796b)'
		},
		'norte': {
			title: 'Região Norte',
			subtitle: 'Ferrovias do Norte',
			description: 'Integração ferroviária na região Norte do Brasil e projetos de desenvolvimento sustentável.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #1b5e20, #388e3c)'
		},
		// Sudeste
		'sao-paulo': {
			title: 'Estado de São Paulo',
			subtitle: 'São Paulo Ferroviário',
			description: 'O maior polo de transporte sobre trilhos do país: novidades da CPTM, Metrô de São Paulo, concessões e ferrovias paulistas.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #2c3e50, #3498db)'
		},
		'rio-de-janeiro': {
			title: 'Estado do Rio de Janeiro',
			subtitle: 'Rio de Janeiro Ferroviário',
			description: 'Projetos de mobilidade na capital fluminense, SuperVia, VLT Carioca, MetrôRio e a infraestrutura logística do estado.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #0f2027, #203a43, #2c5364)'
		},
		'minas-gerais': {
			title: 'Minas Gerais',
			subtitle: 'Ferrovias de Minas Gerais',
			description: 'O coração logístico do Brasil: ferrovias de minério, passageiros e a malha integrada mineira.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #3e2723, #6d4c41)'
		},
		'espirito-santo': {
			title: 'Espírito Santo',
			subtitle: 'Ferrovias do Espírito Santo',
			description: 'A ligação ferroviária entre o interior e os portos capixabas. Logística de minério e carga geral.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #1a237e, #3949ab)'
		},
		// Sul
		'parana': {
			title: 'Paraná',
			subtitle: 'Ferrovias do Paraná',
			description: 'A malha ferroviária paranaense: integração com portos, graneis e mobilidade urbana em Curitiba.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #1b3a4b, #2c5364)'
		},
		'santa-catarina': {
			title: 'Santa Catarina',
			subtitle: 'Ferrovias de Santa Catarina',
			description: 'Ferrovias catarinenses: logística portuária, integração regional e projetos de mobilidade.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #0d3b66, #1565c0)'
		},
		'rio-grande-do-sul': {
			title: 'Rio Grande do Sul',
			subtitle: 'Ferrovias do Rio Grande do Sul',
			description: 'A história ferroviária gaúcha e os projetos de retomada do modal no estado mais ao sul do Brasil.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #1a1a2e, #16213e)'
		},
		// Centro-Oeste
		'mato-grosso': {
			title: 'Mato Grosso',
			subtitle: 'Ferrovias de Mato Grosso',
			description: 'A soja sobre trilhos: ferrovias de carga que integram o agronegócio mato-grossense aos portos.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #2e7d32, #66bb6a)'
		},
		'goias': {
			title: 'Goiás',
			subtitle: 'Ferrovias de Goias',
			description: 'Projetos ferroviários em Goiás e a integração do Centro-Oeste às principais malhas nacionais.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #bf360c, #e64a19)'
		},
		'distrito-federal': {
			title: 'Distrito Federal',
			subtitle: 'Ferrovias do DF',
			description: 'VLT de Brasília, projetos de mobilidade e a ferrovia no coração do país.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #006064, #00838f)'
		},
		// Brasil & Américas
		'brasil': {
			title: 'Infraestrutura Nacional',
			subtitle: 'Ferrovias do Brasil',
			description: 'A política nacional de transportes, o Novo PAC, investimentos federais e a grande retomada do modal ferroviário no país.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #11998e, #38ef7d)'
		},
		'america-sul': {
			title: 'América do Sul',
			subtitle: 'Ferrovias Sul-Americanas',
			description: 'Bioceânica, trens argentinos, chilenos, peruanos e a integração ferroviária do continente.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #4a148c, #7b1fa2)'
		},
		'america-norte': {
			title: 'América do Norte',
			subtitle: 'Ferrovias Norte-Americanas',
			description: 'Amtrak, trens de carga norte-americanos e as maiores redes ferroviárias do continente.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #1a237e, #283593)'
		},
		// Tópicos adicionais
		'infraestrutura': {
			title: 'Infraestrutura',
			subtitle: 'Infraestrutura Ferroviária',
			description: 'Obras, concessões, leilões e investimentos em infraestrutura ferroviária no Brasil e no mundo.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #37474f, #546e7a)'
		},
		'novo-pac': {
			title: 'Novo PAC',
			subtitle: 'Programa de Aceleração do Crescimento',
			description: 'As obras do Novo PAC com foco em ferrovias, investimentos federais e projetos estruturantes.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #004d40, #00695c)'
		},
		'mobilidade-urbana': {
			title: 'Mobilidade Urbana',
			subtitle: 'Transporte Urbano sobre Trilhos',
			description: 'Metrôs, VLTs, trens urbanos e as soluções de mobilidade sobre trilhos para as grandes cidades.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #263238, #455a64)'
		},
		'brasilia': {
			title: 'Brasília',
			subtitle: 'Ferrovias do Distrito Federal',
			description: 'Projetos de mobilidade em Brasília: VLT, metrô e integração ferroviária no Planalto Central.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #004d40, #00796b)'
		},
		'patrimonio': {
			title: 'Patrimônio',
			subtitle: 'Patrimônio Ferroviário',
			description: 'Preservação da história ferroviária, estações históricas, Maria Fumaça e memória dos trilhos.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #5d4037, #8d6e63)'
		},
		'aps': {
			title: 'APS',
			subtitle: 'Alimentação pelo Solo',
			description: 'Tecnologia APS (Alimentação pelo Solo) em VLTs e bondes: inovação sem catenária aérea.',
			image: '/images/tags/default.png',
			color: 'linear-gradient(135deg, #33691e, #558b2f)'
		},
	};

	const allPosts = await getCollection('blog');
	const tagsFromPosts = [...new Set(allPosts.map((post) => post.data.tags || []).flat())];
	const allTags = [...new Set([...Object.keys(tagMap), ...tagsFromPosts])];

	return allTags.map((tag) => {
		const filteredPosts = allPosts.filter((post) => post.data.tags?.includes(tag));
		return {
			params: { tag },
			props: { 
				posts: filteredPosts,
				meta: tagMap[tag]
			},
		};
	});
}

const { tag } = Astro.params;
const { posts, meta: propMeta } = Astro.props;

// Sort by date
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const meta = propMeta || {
	title: 'Tag do Mundo Trilhos',
	subtitle: tag.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
	description: `Notícias e análises aprofundadas sobre ${tag.split('-').join(' ')} no portal Mundo Trilhos.`,
	image: '/images/tags/default.png',
	color: 'linear-gradient(135deg, #2f3640, #57606f)',
	bgPosition: 'center'
};
---

<!doctype html>
<html lang="pt-br">
	<head>
		<BaseHead title={`${meta.subtitle} - ${SITE_TITLE}`} description={meta.description} />
		<style>
			@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@800&family=Outfit:wght@400;500;600;700&display=swap');

			main {
				max-width: 1000px;
				margin: 0 auto;
				padding: 0 1.5rem;
			}
			.tag-hero {
				background: #ffffff;
				border-radius: 24px;
				border: 1px solid rgba(0,0,0,0.06);
				box-shadow: 0 10px 30px rgba(0,0,0,0.04);
				overflow: hidden;
				margin-bottom: 3.5rem;
				margin-top: 2rem;
				display: flex;
				flex-direction: column;
				transition: border-color 0.3s ease;
			}
			.tag-hero:hover {
				border-color: rgba(0,0,0,0.12);
			}
			.tag-hero-image-wrapper {
				width: 100%;
				height: 280px;
				overflow: hidden;
				position: relative;
				border-bottom: 1px solid rgba(0,0,0,0.06);
			}
			.tag-hero-image {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
				display: block;
			}
			.tag-hero:hover .tag-hero-image {
				transform: scale(1.025);
			}
			.tag-hero-content {
				padding: 2.5rem;
				background: #1e272e;
				color: white;
				text-align: left;
			}
			.tag-title {
				font-family: 'Outfit', sans-serif;
				font-size: 0.8rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 2px;
				color: #ffc048;
				margin: 0 0 0.5rem 0;
				display: inline-block;
				background: rgba(255, 192, 72, 0.12);
				padding: 4px 12px;
				border-radius: 20px;
				border: 1px solid rgba(255, 192, 72, 0.25);
			}
			.tag-subtitle {
				font-family: 'Montserrat', sans-serif;
				font-size: 2.1rem;
				font-weight: 800;
				margin: 0.25rem 0 0.75rem 0;
				line-height: 1.2;
				color: #ffffff;
			}
			.tag-description {
				font-family: 'Outfit', sans-serif;
				font-size: 1.05rem;
				line-height: 1.6;
				color: rgba(255, 255, 255, 0.85);
				margin: 0;
			}
			
			/* Grid Styles */
			ul {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 2.5rem;
				list-style-type: none;
				margin: 0 0 4rem 0;
				padding: 0;
			}
			ul li {
				background: white;
				border-radius: 16px;
				overflow: hidden;
				box-shadow: 0 5px 15px rgba(0,0,0,0.03);
				border: 1px solid rgba(0,0,0,0.04);
				transition: transform 0.3s ease, box-shadow 0.3s ease;
			}
			ul li * {
				text-decoration: none;
			}
			ul li img {
				width: 100%;
				height: 240px;
				object-fit: cover;
				display: block;
				border-bottom: 1px solid rgba(0,0,0,0.04);
				transition: transform 0.5s ease;
			}
			ul li a {
				display: block;
			}
			.post-card-content {
				padding: 1.5rem;
			}
			.post-title {
				font-family: 'Outfit', sans-serif;
				margin: 0 0 0.5rem 0;
				color: #2f3640;
				line-height: 1.3;
				font-size: 1.35rem;
				font-weight: 700;
				transition: color 0.2s ease;
			}
			.date {
				margin: 0;
				color: #7f8c8d;
				font-family: 'Outfit', sans-serif;
				font-size: 0.85rem;
				font-weight: 500;
			}
			
			/* Hover Effects */
			ul li:hover {
				transform: translateY(-6px);
				box-shadow: 0 15px 30px rgba(0,0,0,0.08);
			}
			ul li:hover .post-title {
				color: #0052D4;
			}
			ul li:hover img {
				transform: scale(1.02);
			}

			/* Estado vazio */
			.empty-state {
				text-align: center;
				padding: 4rem 2rem;
				color: #7f8c8d;
				font-family: 'Outfit', sans-serif;
			}
			.empty-state h3 {
				font-size: 1.5rem;
				color: #2f3640;
				margin-bottom: 0.5rem;
			}
			.empty-state p {
				font-size: 1rem;
				max-width: 500px;
				margin: 0 auto;
			}

			@media (max-width: 768px) {
				main {
					padding: 0 1rem;
				}
				ul {
					grid-template-columns: 1fr;
					gap: 2rem;
				}
				.tag-hero {
					border-radius: 16px;
					margin-bottom: 2.5rem;
				}
				.tag-hero-image-wrapper {
					height: 200px;
				}
				.tag-hero-content {
					padding: 1.5rem;
				}
				.tag-subtitle {
					font-size: 1.6rem;
				}
				.tag-description {
					font-size: 0.95rem;
				}
				ul li img {
					height: 200px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tag-hero">
				<div class="tag-hero-image-wrapper">
					<img src={meta.image} alt={meta.subtitle} class="tag-hero-image" style={`object-position: ${meta.bgPosition || 'center 35%'};`} />
				</div>
				<div class="tag-hero-content">
					<span class="tag-title">{meta.title}</span>
					<h1 class="tag-subtitle">{meta.subtitle}</h1>
					<p class="tag-description">{meta.description}</p>
				</div>
			</div>
			
			<section>
				{sortedPosts.length > 0 ? (
					<ul>
						{
							sortedPosts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										{post.data.heroImage && (
											<img src={post.data.heroImage} alt={post.data.title} />
										)}
										<div class="post-card-content">
											<h4 class="post-title">{post.data.title}</h4>
											<p class="date">
												<FormattedDate date={post.data.pubDate} />
											</p>
										</div>
									</a>
								</li>
							))
						}
					</ul>
				) : (
					<div class="empty-state">
						<h3>Em breve</h3>
						<p>Ainda não temos artigos sobre <strong>{meta.subtitle}</strong>. Volte em breve — novas publicações chegam todos os dias!</p>
					</div>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
